    },
    "This image is too large. Use an image with no more than 100 million pixels and no side longer than 32,768 pixels.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This image is too large. Use an image with no more than 100 million pixels and no side longer than 32,768 pixels."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片尺寸过大。请使用不超过 1 亿像素、边长不超过 32,768 像素的图片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片尺寸過大。請使用不超過 1 億像素，且任一邊不超過 32,768 像素的圖片。"
          }
        }
      }
    },
    "This system cannot encode the selected format. Choose another format.": {
